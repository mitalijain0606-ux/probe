generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum CheckStatus {
  UP
  DOWN
}

enum ErrorType {
  TIMEOUT
  DNS_FAILURE
  CONNECTION_REFUSED
  SSL_ERROR
  BLOCKED_TARGET
  INVALID_URL
  HTTP_ERROR
  NETWORK_ERROR
  UNKNOWN
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @db.VarChar(120)
  email        String         @unique @db.VarChar(255)
  passwordHash String
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  urls         MonitoredUrl[]

  @@map("users")
}

model MonitoredUrl {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  url            String        @db.VarChar(2048)
  label          String?       @db.VarChar(120)
  isActive       Boolean       @default(true)
  intervalSec    Int           @default(300)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks         CheckResult[]
  stats          UrlStats?

  @@unique([userId, url])
  @@index([userId, isActive])
  @@index([isActive, id])
  @@map("monitored_urls")
}

model CheckResult {
  id             BigInt       @id @default(autoincrement())
  urlId          String       @db.Uuid
  status         CheckStatus
  statusCode     Int?
  responseTimeMs Int?
  errorType      ErrorType?
  errorMessage   String?      @db.VarChar(500)
  attempts       Int          @default(1)
  checkedAt      DateTime     @default(now())
  url            MonitoredUrl @relation(fields: [urlId], references: [id], onDelete: Cascade)

  @@index([urlId, checkedAt(sort: Desc)])
  @@index([checkedAt])
  @@map("check_results")
}

model UrlStats {
  urlId              String        @id @db.Uuid
  totalChecks        BigInt        @default(0)
  successfulChecks   BigInt        @default(0)
  failedChecks       BigInt        @default(0)
  totalResponseTime  BigInt        @default(0)
  responseSamples    BigInt        @default(0)
  lastStatus         CheckStatus?
  lastStatusCode     Int?
  lastResponseTimeMs Int?
  lastErrorType      ErrorType?
  lastCheckedAt      DateTime?
  consecutiveFails   Int           @default(0)
  updatedAt          DateTime      @updatedAt
  url                MonitoredUrl  @relation(fields: [urlId], references: [id], onDelete: Cascade)

  @@map("url_stats")
}
