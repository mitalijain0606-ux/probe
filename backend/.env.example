NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL=postgresql://uho:uho_password@localhost:5432/url_health?schema=public

JWT_SECRET=change-this-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d
COOKIE_NAME=uho_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

FRONTEND_URL=http://localhost:5173

REQUEST_TIMEOUT=10000
MAX_CONCURRENT_CHECKS=10
MONITOR_INTERVAL=300
CHECK_MAX_ATTEMPTS=3
CHECK_RETRY_BASE_MS=250
CHECK_MAX_REDIRECTS=3
CHECK_MAX_BODY_BYTES=65536
USER_AGENT=UrlHealthMonitor/1.0 (+observability-platform)

ALLOW_PRIVATE_TARGETS=false

HISTORY_RETENTION_DAYS=30
ALERT_FAILURE_THRESHOLD=3

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

LOG_LEVEL=info
LOG_PRETTY=true

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
