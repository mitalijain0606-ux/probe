DATABASE_URL=postgresql://uho:uho_password@postgres:5432/url_health?schema=public

JWT_SECRET=change-this-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d
COOKIE_NAME=uho_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

PORT=4000
FRONTEND_URL=http://localhost:5173

REQUEST_TIMEOUT=10000
MAX_CONCURRENT_CHECKS=10
MONITOR_INTERVAL=300

LOG_LEVEL=info
LOG_PRETTY=false

POSTGRES_USER=uho
POSTGRES_PASSWORD=uho_password
POSTGRES_DB=url_health
